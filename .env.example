# 本地运行的环境变量示例（复制为 .env 后 source，或直接在终端 export）
# GitHub Actions 部署不使用本文件，配置在仓库 Secrets / Variables 中

# 阅读次数配置（默认 40 次 / 约 20 分钟）
READ_NUM=40

# 启动随机抖动上限（秒）
# 定时触发后先随机休眠 0~该值秒，避免每天在固定分钟级时刻运行
# 默认 2700（45 分钟）；本地手动测试建议设为 0 禁用
START_JITTER_MAX=2700

# cookie 导出路径（P1-4）
# 运行结束把续期后的最新 cookie 导出为 curl_bash 格式文件
# GitHub Actions 配 PAT_TOKEN 后自动回写 secret；本地可复用该文件内容
# 默认 latest_cookie.txt；设为空字符串禁用导出
WXREAD_COOKIE_EXPORT_PATH=latest_cookie.txt

# 微信读书官方 Agent Gateway API Key（可选，P1-2）
# wrk- 开头，https://weread.qq.com/r/weread-skills 免费获取
# 配置后运行结束会查询并推送"今日实际计入时长"
WEREAD_API_KEY=

# 微信读书 curl bash 命令（必填）
# 获取方式：
# 1. 打开微信读书网页版 https://weread.qq.com/
# 2. 按 F12 打开开发者工具，切换到 Network 标签
# 3. 开始阅读任意书籍，点一下"下一页"
# 4. 找到 /web/book/read 请求，右键 "Copy as cURL (bash)"
# 5. 将完整命令粘贴到下面（必须包含 -H 'cookie: ...'）
#
# 脚本会自动从这条请求的报文里读出 b/c/ci/co/sm/pr 作为阅读池条目，
# 无需手工填任何字段。想加入更多书：多抓几条 read 请求，
# 用空行隔开一起粘贴到这里（或放到下面的 WXREAD_CURL_BASH_2..5）。
WXREAD_CURL_BASH=curl 'https://weread.qq.com/web/book/read' -H 'accept: application/json, text/plain, */*' -H 'cookie: YOUR_COOKIES_HERE' -H 'user-agent: Mozilla/5.0'

# 额外的抓包（可选，2~5）：内容格式与 WXREAD_CURL_BASH 相同，用于多本书/多页随机
WXREAD_CURL_BASH_2=
WXREAD_CURL_BASH_3=
WXREAD_CURL_BASH_4=
WXREAD_CURL_BASH_5=

# 推送方式（可选）：pushplus / wxpusher / telegram / serverchan
PUSH_METHOD=

# PushPlus 推送配置（可选）https://www.pushplus.plus/
PUSHPLUS_TOKEN=

# Telegram 推送配置（可选）
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WxPusher 推送配置（可选）https://wxpusher.zjiecode.com/
WXPUSHER_SPT=

# ServerChan 推送配置（可选）https://sct.ftqq.com/
SERVERCHAN_SPT=
