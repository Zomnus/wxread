# 阅读次数配置 (默认40次/20分钟)
READ_NUM=40

# 启动随机抖动上限 (秒)
# 定时触发后先随机休眠 0~该值秒，避免每天在固定分钟级时刻运行
# 默认 2700 (45分钟)；本地手动测试可设为 0 禁用
START_JITTER_MAX=2700

# cookie 导出路径 (P1-4)
# 运行结束把续期后的最新 cookie 导出为 curl_bash 格式文件
# Actions 形态配 PAT_TOKEN 后自动回写 secret；本地可直接复用该文件内容
# 默认 latest_cookie.txt；设为空字符串禁用导出
WXREAD_COOKIE_EXPORT_PATH=latest_cookie.txt

# 微信读书官方 Agent Gateway API Key (可选, P1-2)
# wrk- 开头，https://weread.qq.com/r/weread-skills 免费获取
# 配置后运行结束会查询并推送"今日实际计入时长"，用于核对是否被服务端计入
WEREAD_API_KEY=

# 微信读书 curl bash 命令 (必需)
# 获取方式：
# 1. 打开微信读书网页版 https://weread.qq.com/
# 2. 打开浏览器开发者工具 (F12)
# 3. 切换到 Network 标签
# 4. 开始阅读任意书籍
# 5. 找到 'read' 请求，右键选择 "Copy as cURL (bash)"
# 6. 将完整的 curl 命令粘贴到下面
WXREAD_CURL_BASH=curl 'https://weread.qq.com/web/book/read' -H 'accept: application/json, text/plain, */*' -H 'cookie: YOUR_COOKIES_HERE' -H 'user-agent: Mozilla/5.0'

# 推送方式 (可选)
# 支持: pushplus, wxpusher, telegram, serverchan
PUSH_METHOD=

# PushPlus 推送配置 (可选)
# 官网: https://www.pushplus.plus/
PUSHPLUS_TOKEN=

# Telegram 推送配置 (可选)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# WxPusher 推送配置 (可选)
# 官网: https://wxpusher.zjiecode.com/
WXPUSHER_SPT=

# ServerChan 推送配置 (可选)
# 官网: https://sct.ftqq.com/
SERVERCHAN_SPT=

# 定时任务配置 (Cron 表达式格式)
# 默认每天凌晨1点执行: 0 1 * * *
# 其他示例:
#   每6小时: 0 */6 * * *
#   每天早上8:30: 30 8 * * *
#   每天中午12点: 0 12 * * *
CRON_SCHEDULE=0 1 * * *
